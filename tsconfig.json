{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": { "rn-material-symbols/registry": ["./src/registry/stub.js"] }
  },
  "include": ["src", "scripts", "test", "metro.js", "jest.js", "registry.js"],
  "exclude": ["test/fixtures"]
}
