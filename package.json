{
  "name": "rn-material-symbols",
  "version": "0.2.0",
  "description": "Google Material Symbols for React Native by name — only the icons your source uses are bundled.",
  "keywords": ["react-native", "material-symbols", "material-icons", "icons", "svg", "metro"],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.19.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "lib/index.js",
  "files": [
    "lib",
    "icons",
    "registry.js",
    "metro.js",
    "metro.d.ts",
    "jest.js",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": "./registry.js",
    "./icons/*": "./icons/*.js",
    "./metro": {
      "types": "./metro.d.ts",
      "default": "./metro.js"
    },
    "./jest": "./jest.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=13"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9"
  },
  "optionalDependencies": {
    "rn-material-symbols-scanner-native": "workspace:*"
  },
  "scripts": {
    "fetch:icons": "tsx scripts/fetch-cdn.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "build": "pnpm build:icons && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e:consumer": "bash e2e/consumer.sh",
    "e2e:expo": "bash e2e/expo.sh",
    "e2e:linux": "bash e2e/linux.sh",
    "build:native": "pnpm --filter rn-material-symbols-scanner-native build",
    "test:native": "cargo test --manifest-path native/Cargo.toml"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/types": "^7.29.8",
    "@react-native/babel-preset": "0.78.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.0.0",
    "react-native": "0.78.3",
    "react-native-svg": "15.13.0",
    "react-test-renderer": "19.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.2"
  }
}
